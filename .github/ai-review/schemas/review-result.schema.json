{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dGkdu/ldb/.github/ai-review/schemas/review-result.schema.json",
  "title": "Provider-neutral AI review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["headSha", "summary", "findings", "missingContext"],
  "properties": {
    "headSha": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "confidence",
          "path",
          "line",
          "evidence",
          "impact",
          "suggestedAction"
        ],
        "properties": {
          "severity": { "enum": ["P0", "P1", "P2", "P3", "info"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "suggestedAction": { "type": "string", "minLength": 1 }
        }
      }
    },
    "missingContext": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

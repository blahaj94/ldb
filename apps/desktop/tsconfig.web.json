{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/frontend/src/env.d.ts",
    "src/frontend/src/**/*",
    "src/frontend/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@frontend/*": [
        "./src/frontend/src/*"
      ]
    }
  }
}

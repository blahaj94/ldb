{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@ldb/ui": ["./src/index.tsx"]
    }
  },
  "include": ["src", "test", "vitest.config.ts", "build", "vite.config.ts", "examples"]
}

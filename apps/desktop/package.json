{
  "name": "@ldb/desktop",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/backend/main.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --write \"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,yaml,yml,css,scss,less,html}\"",
    "lint": "eslint .",
    "prepare:ocr-assets": "node scripts/prepare-ocr-assets.mjs",
    "test": "vitest run",
    "test:windows-native": "tsc --noEmit -p scripts/windows-security-fixture/tsconfig.json && vitest run --config scripts/windows-security-fixture/vitest.config.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "npm run prepare:ocr-assets && electron-vite dev",
    "build": "npm run typecheck && npm run prepare:ocr-assets && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run prepare:ocr-assets && electron-vite build && electron-builder --mac",
    "build:linux": "npm run prepare:ocr-assets && electron-vite build && electron-builder --linux",
    "ui:fixture": "tsc scripts/ui-fixture-preload.cts --outDir node_modules/.tmp/ui-fixture --module commonjs --moduleResolution node --target es2022 --strict --skipLibCheck && electron scripts/ui-fixture.mjs",
    "auth:fixture:build": "tsc --noEmit -p scripts/auth-bridge-fixture/tsconfig.json --composite false && electron-vite build --config scripts/auth-bridge-fixture.config.ts",
    "auth:fixture": "node scripts/auth-bridge-fixture.mjs",
    "auth:fixture:smoke": "node scripts/auth-bridge-fixture.mjs --smoke",
    "capture:fixture:build": "npm run prepare:ocr-assets && tsc --noEmit -p scripts/auth-capture-fixture/tsconfig.json --composite false && electron-vite build --config scripts/auth-capture-fixture.config.ts",
    "capture:fixture": "node scripts/auth-capture-fixture.mjs",
    "capture:fixture:search": "node scripts/auth-capture-fixture.mjs --search-smoke",
    "capture:fixture:smoke": "node scripts/auth-capture-fixture.mjs --smoke",
    "capture:fixture:ocr": "node scripts/auth-capture-fixture.mjs --ocr",
    "capture:fixture:deny": "node scripts/auth-capture-fixture.mjs --deny-media",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --check \"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,yaml,yml,css,scss,less,html}\""
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "koffi": "3.2.1",
    "ky": "2.1.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.11",
    "@ldb/ui": "workspace:*",
    "@seed-design/react": "2.4.1",
    "@seed-design/css": "2.7.0",
    "@seed-design/vite-plugin": "2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
